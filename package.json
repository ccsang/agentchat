{
  "name": "@ccsang/agentchat",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Lightweight local communication for coding agents, with agent-driven onboarding.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "agentchat": "./bin/agentchat"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "check": "tsc --noEmit",
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "test": "bun test tests",
    "test:native": "bun run scripts/start-native-test.ts",
    "verify:native": "bun run scripts/verify-native.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
