{
  "name": "@ccsang/agentchat",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Lightweight local communication for coding agents, with agent-driven onboarding.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "agentchat": "./bin/agentchat"
